module

public import Galois.RadicalTower.Basic
public import Mathlib.FieldTheory.AbelRuffini

/-!
# Comparing finite radical towers with mathlib's radical closure

The fixed ambient field is essential: a field inside a radical extension need not itself be
a radical extension. The converse statements below produce a possibly larger endpoint.
The bridge reuses mathlib's algebraicity and Abel–Ruffini results. Exponent one in
`solvableByRad` is removed as a trivial step.
-/

public section

open IntermediateField

universe u v

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]

namespace IntermediateField.IsRadicalTower

variable {F E : IntermediateField K L}

/-- Radical adjunction preserves containment in mathlib's radical closure. -/
theorem le_solvableByRad (h : IsRadicalTower F E) (hF : F ≤ solvableByRad K L) :
    E ≤ solvableByRad K L := by
  induction h with
  | refl => exact hF
  | adjoin _ a n hn hp ih =>
    refine sup_le ih (IntermediateField.adjoin_le_iff.mpr ?_)
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    exact solvableByRad.rad_mem (ne_of_gt (lt_of_lt_of_le (by decide : 0 < 2) hn)) (ih hp)

/-- Every element of a finite radical tower starting at the image of `K` is integral over `K`. -/
theorem isIntegral (h : IsRadicalTower (⊥ : IntermediateField K L) E) {x : L} (hx : x ∈ E) :
    IsIntegral K x :=
  isIntegral_of_mem_solvableByRad (h.le_solvableByRad bot_le hx)

/-- A finite radical tower over the base field has finite-dimensional endpoint. -/
theorem finiteDimensional (h : IsRadicalTower (⊥ : IntermediateField K L) E) :
    FiniteDimensional K E := by
  obtain ⟨s, hs⟩ := h.fg IntermediateField.fg_bot
  rw [← hs]
  apply IntermediateField.finiteDimensional_adjoin
  intro x hx
  exact h.isIntegral (hs ▸ IntermediateField.subset_adjoin K (s : Set L) hx)

end IntermediateField.IsRadicalTower

/-- A radical-closure element has a finite radical tower witness in the same ambient
field. The witness endpoint may be larger than the field generated by that element. -/
theorem exists_isRadicalTower_of_mem_solvableByRad {x : L} (hx : x ∈ solvableByRad K L) :
    ∃ E : IntermediateField K L, IsRadicalTower ⊥ E ∧ x ∈ E := by
  induction hx using solvableByRad.induction with
  | mem a => exact ⟨⊥, .refl _, IntermediateField.algebraMap_mem _ a⟩
  | add x y _ _ ihx ihy =>
    obtain ⟨E, hE, hxE⟩ := ihx
    obtain ⟨F, hF, hyF⟩ := ihy
    exact ⟨E ⊔ F, hE.sup hF,
      add_mem ((show E ≤ E ⊔ F from le_sup_left) hxE)
        ((show F ≤ E ⊔ F from le_sup_right) hyF)⟩
  | mul x y _ _ ihx ihy =>
    obtain ⟨E, hE, hxE⟩ := ihx
    obtain ⟨F, hF, hyF⟩ := ihy
    exact ⟨E ⊔ F, hE.sup hF,
      mul_mem ((show E ≤ E ⊔ F from le_sup_left) hxE)
        ((show F ≤ E ⊔ F from le_sup_right) hyF)⟩
  | rad n x hn _ ih =>
    obtain ⟨E, hE, hpow⟩ := ih
    by_cases hn1 : n = 1
    · exact ⟨E, hE, by simpa only [hn1, pow_one] using hpow⟩
    · have hn2 : 2 ≤ n := by omega
      exact ⟨E ⊔ K⟮x⟯, hE.adjoin x n hn2 hpow,
        (show K⟮x⟯ ≤ E ⊔ K⟮x⟯ from le_sup_right) (mem_adjoin_simple_self K x)⟩

/-- Membership in the radical closure is equivalent to a finite radical-tower witness. -/
theorem mem_solvableByRad_iff_exists_isRadicalTower {x : L} :
    x ∈ solvableByRad K L ↔
      ∃ E : IntermediateField K L, IsRadicalTower ⊥ E ∧ x ∈ E := by
  refine ⟨exists_isRadicalTower_of_mem_solvableByRad, ?_⟩
  rintro ⟨E, hE, hx⟩
  exact hE.le_solvableByRad bot_le hx

/-- Finitely many radical-closure elements have one common finite tower witness. -/
theorem exists_isRadicalTower_of_finset (s : Finset L)
    (hs : ∀ x ∈ s, x ∈ solvableByRad K L) :
    ∃ E : IntermediateField K L, IsRadicalTower ⊥ E ∧ ∀ x ∈ s, x ∈ E := by
  classical
  revert hs
  induction s using Finset.induction_on with
  | empty => exact fun _ ↦ ⟨⊥, .refl _, by simp⟩
  | @insert x s _ ih =>
    intro hs
    obtain ⟨E, hE, hxE⟩ :=
      exists_isRadicalTower_of_mem_solvableByRad (hs x (Finset.mem_insert_self ..))
    obtain ⟨F, hF, hsF⟩ := ih (fun y hy ↦ hs y (Finset.mem_insert_of_mem hy))
    refine ⟨E ⊔ F, hE.sup hF, ?_⟩
    intro y hy
    rcases Finset.mem_insert.mp hy with rfl | hy
    · exact (show E ≤ E ⊔ F from le_sup_left) hxE
    · exact (show F ≤ E ⊔ F from le_sup_right) (hsF y hy)

/-- The finite-set version, suitable for sets of polynomial roots. -/
theorem exists_isRadicalTower_of_finite {s : Set L} (hs : s.Finite)
    (hrad : s ⊆ solvableByRad K L) :
    ∃ E : IntermediateField K L, IsRadicalTower ⊥ E ∧ s ⊆ E := by
  classical
  obtain ⟨E, hE, hmem⟩ := exists_isRadicalTower_of_finset hs.toFinset
    (fun x hx ↦ hrad (hs.mem_toFinset.mp hx))
  exact ⟨E, hE, fun x hx ↦ hmem x (hs.mem_toFinset.mpr hx)⟩

/-- A finitely generated intermediate field in the radical closure is contained in
a finite radical endpoint. It is not claimed to be a radical endpoint itself. -/
theorem exists_isRadicalTower_of_fg {E : IntermediateField K L} (hfg : E.FG)
    (hrad : E ≤ solvableByRad K L) :
    ∃ M : IntermediateField K L, IsRadicalTower ⊥ M ∧ E ≤ M := by
  obtain ⟨s, hs⟩ := hfg
  obtain ⟨M, hM, hsM⟩ := exists_isRadicalTower_of_finset s
    (fun x hx ↦ hrad (hs ▸ IntermediateField.subset_adjoin K (s : Set L) hx))
  refine ⟨M, hM, ?_⟩
  rw [← hs]
  exact IntermediateField.adjoin_le_iff.mpr hsM

/-- A finite-dimensional intermediate field contained in the radical closure
is contained in a finite radical endpoint; this applies in particular to finite splitting fields. -/
theorem exists_isRadicalTower_of_finiteDimensional (E : IntermediateField K L)
    [FiniteDimensional K E] (hrad : E ≤ solvableByRad K L) :
    ∃ M : IntermediateField K L, IsRadicalTower ⊥ M ∧ E ≤ M := by
  apply exists_isRadicalTower_of_fg _ hrad
  exact IntermediateField.essFiniteType_iff.mp inferInstance

/-- Mathlib's radical closure is precisely the supremum of the finite radical endpoints
inside this ambient field. -/
theorem solvableByRad_eq_iSup_isRadicalTower :
    solvableByRad K L =
      ⨆ E : {E : IntermediateField K L // IsRadicalTower ⊥ E}, E.1 := by
  apply le_antisymm
  · intro x hx
    obtain ⟨E, hE, hxE⟩ := exists_isRadicalTower_of_mem_solvableByRad hx
    exact (le_iSup (fun M : {M : IntermediateField K L // IsRadicalTower ⊥ M} ↦ M.1)
      ⟨E, hE⟩) hxE
  · exact iSup_le fun E ↦ E.2.le_solvableByRad bot_le
